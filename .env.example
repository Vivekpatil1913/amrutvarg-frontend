# Registration forms run in preview mode by default: they validate input but
# send nothing. Set to "true" to post to the existing AMRUT VARG service
# (the same endpoints the live portal uses).
VITE_ENABLE_LIVE_SUBMIT=false
VITE_API_BASE=https://d1n58pfwi63jf3.cloudfront.net

# The active Amrut Varg list comes from the bundled snapshot (src/data/vargs.js)
# by default. Set to "true" to read the latest approved list from the service
# at VITE_API_BASE (GET /api/amrut-vargs/active). The service must allow this
# site's origin (CORS). If the request fails, the snapshot is shown instead.
VITE_ENABLE_LIVE_CONTENT=false
