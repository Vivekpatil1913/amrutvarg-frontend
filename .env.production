VITE_STORIES_API=/api/stories
VITE_ENABLE_LIVE_CONTENT=false

# CMS backend (Amrutvarg-backend), reverse-proxied by nginx on the same domain
VITE_CMS_API=https://amrutvarg.mahaamrut.org.in/api/v1
