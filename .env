# Base URL of the AMRUT VARG service — the same backend the live portal uses.
VITE_API_BASE=https://d1n58pfwi63jf3.cloudfront.net

# Registration forms run in preview mode when this is not "true": they validate
# input but send nothing. "true" posts to the AMRUT VARG service at
# VITE_API_BASE (the same endpoints the live portal uses).
VITE_ENABLE_LIVE_SUBMIT=true

# Success stories are paged on the server: GET /api/stories?page=&pageSize=
# &category=&q=&lang= (server/storiesApi.js), served by `npm run dev` and
# `npm run preview`. A production host must serve the same route (or proxy it
# to the backend); point this at it if it lives elsewhere. Without a reachable
# endpoint the page pages the bundled stories in the browser instead.
VITE_STORIES_API=/api/stories

# The active Amrut Varg list comes from the bundled snapshot (src/data/vargs.js)
# when this is not "true". Set to "true" to read the latest approved list from
# the service at VITE_API_BASE (GET /api/amrut-vargs/active). The service must
# allow this site's origin (CORS). If the request fails, the snapshot is shown.
VITE_ENABLE_LIVE_CONTENT=false

# Unused: no code reads VITE_CMS_API. Kept here as a note; delete if not needed.
VITE_CMS_API=/api/v1
